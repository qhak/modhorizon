{
  "name": "modhorizon",
  "version": "0.22.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3215",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3215",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "package:shader-foundation": "tsx scripts/shaders/package-foundation.ts",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "db:migrate:local": "wrangler d1 migrations apply modhorizon-billing --local",
    "db:migrate:remote": "wrangler d1 migrations apply modhorizon-billing --remote",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "build:html": "next build && tsx scripts/static-index/build.ts",
    "setup:local-builder": "node scripts/local-builder-setup.mjs",
    "prepare:local-builder": "tsx build-service/local/prepare.ts",
    "local:builder": "tsx build-service/local/start.ts",
    "local:preview": "node scripts/local-preview.mjs",
    "check:local-builder": "tsx build-service/local/check.ts",
    "check:local-builder-http": "tsx build-service/local/check-http.ts",
    "check:local-builder-deadline": "tsx build-service/local/check-deadline.ts",
    "sync:shader-foundation": "tsx scripts/shaders/sync-foundation.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "undici": "^7.30.1",
    "wrangler": "^4.151.3"
  }
}
