# Local preview defaults. Mock generation is rejected in production.
AI_PROVIDER=mock

# Provider API keys stay on the server. The model picker shows options only when
# their provider is configured. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/

# Legacy OpenAI-compatible Chat Completions configuration.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1/

# Exact POST endpoint of your independently provisioned, isolated build worker.
# Leave unset for an honest source-only preview in development.
# Production requires both values. A URL alone does not create a sandbox.
BUILD_SERVICE_URL=
BUILD_SERVICE_TOKEN=
