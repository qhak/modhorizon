{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modhorizon",
  "account_id": "b57b2f90db289dc433f181c3ac0626be",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "modhorizon" }
  ],
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "modhorizon-billing",
      "database_id": "34f5aa89-4f90-47ea-b8c5-3d8bb4fd8b2e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_PROVIDER": "openai-compatible",
    "AI_TESTING_MODE": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
